# Database
DATABASE_NAME=one9data
DATABASE_USER=one9user
DATABASE_PASSWORD=your_password
DATABASE_HOST=your_host
DATABASE_PORT=5432

# Django
SECRET_KEY=your_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# One9Founders Cloud (OpenWorker broker) — data stays on One9, not OpenWorker Cloud
COWORKER_CLOUD_CLIENT_ID=one9founders-openworker-dev
COWORKER_CLOUD_PUBLIC_URL=http://127.0.0.1:8000
COWORKER_CLOUD_AUDIENCE=http://127.0.0.1:8000

# Windows One9 worker installer (optional). After building the EXE:
#   python manage.py publish_openworker_windows path\to\One9Worker-Setup.exe
OPENWORKER_WINDOWS_FILENAME=One9Worker-Setup.exe
OPENWORKER_WINDOWS_S3_BUCKET=one9founders-openworker-downloads
OPENWORKER_WINDOWS_S3_KEY=windows/One9Worker-Setup.exe
OPENWORKER_WINDOWS_DOWNLOAD_URL=https://github.com/one9founders-org/backend/releases/download/windows-worker-v0.1.7/One9Worker-Setup.exe
OPENWORKER_WINDOWS_VERSION=0.1.7

# Managed connector OAuth (one-click connect via the broker) — simple,
# no-relay providers only. Slack/GitHub need a relay service and aren't here.
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# GitHub (tool discovery: search + repo facts)
GITHUB_TOKEN=your_github_token

# Automated discovery trigger (cron-job.org POST /internal/run-discovery/)
# Header: X-Trigger-Secret: <this value>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCOVERY_TRIGGER_SECRET=generate_a_long_random_secret

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_REGION_NAME=ap-south-1

# AWS SES Configuration
AWS_SES_REGION_NAME=ap-south-1
DEFAULT_FROM_EMAIL=noreply@one9founders.com
